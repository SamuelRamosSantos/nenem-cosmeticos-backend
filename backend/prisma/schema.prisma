// =============================================================================
// Nenem Cosméticos — schema.prisma
// Arquitetura Offline-First com suporte a WatermelonDB
//
// Mudanças v2:
//   - Pessoa.tipo       : enum TipoPessoa removido → String ('C' | 'F')
//   - Produto.tipo_baixa: enum TipoBaixa removido  → String ('I' | 'M')
//   - Produto.marca_id  : obrigatório → opcional (String?)
//   - Produto: + movimenta_estoque Boolean, + ativo Boolean
//   - Marca:   + ativo Boolean
//   - VendaHeader: + data_venda DateTime?
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// USUÁRIOS — autenticação local sincronizada via WatermelonDB
// senha: texto puro por ora; migrar para hash (bcrypt) antes de produção
// =============================================================================
model Usuario {
  id         String   @id @default(uuid())
  nome       String
  senha      String
  ativo      Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted    Boolean  @default(false)

  @@map("usuarios")
}

// =============================================================================
// PESSOAS (clientes e fornecedores)
// tipo: 'C' = Cliente | 'F' = Fornecedor
// =============================================================================
model Pessoa {
  id         String   @id @default(uuid())
  nome       String
  telefone   String?
  tipo       String   // 'C' (Cliente) | 'F' (Fornecedor)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted    Boolean  @default(false)

  compras               CompraHeader[]
  vendas                VendaHeader[]
  estoque_movimentacoes EstoqueMovimentacao[]
  titulos               Titulo[]

  @@map("pessoas")
}

// =============================================================================
// MARCAS
// ativo: false = inativada (soft delete de negócio, preserva histórico)
// =============================================================================
model Marca {
  id                  String   @id @default(uuid())
  nome                String
  percentual_comissao Decimal  @db.Decimal(5, 2)
  ativo               Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  deleted             Boolean  @default(false)

  produtos Produto[]

  @@map("marcas")
}

// =============================================================================
// FORMAS DE PAGAMENTO
// =============================================================================
model FormaPagamento {
  id         String   @id @default(uuid())
  descricao  String
  tipo       String   @default("V") // 'V' = À vista | 'C' = Cartão | 'P' = A prazo
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted    Boolean  @default(false)

  // NC-72 — só usados quando tipo = 'P' (a prazo)
  intervalo_dias           Int?
  limite_parcelas          Int?
  juros_percentual_padrao  Decimal? @db.Decimal(5, 2)

  vendas_pagamentos  VendaPagamento[]
  compras_pagamentos CompraPagamento[]
  taxas_cartao       FormaPagamentoTaxa[]
  titulos_baixas     TituloBaixa[]

  @@map("formas_pagamento")
}

// =============================================================================
// TAXAS DE CARTÃO (NC-71) — só existem para formas_pagamento com tipo = 'C'.
// Débito: sempre 1 linha (parcelas = 1). Crédito: até 18 linhas (parcelas 1-18).
// =============================================================================
model FormaPagamentoTaxa {
  id                 String  @id @default(uuid())
  forma_pagamento_id String
  modalidade         String  // 'D' = Débito | 'C' = Crédito
  parcelas           Int     // 1 para Débito; 1 a 18 para Crédito
  taxa_percentual    Decimal @db.Decimal(5, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted    Boolean  @default(false)

  forma_pagamento FormaPagamento @relation(fields: [forma_pagamento_id], references: [id])

  @@unique([forma_pagamento_id, modalidade, parcelas])
  @@map("forma_pagamento_taxas")
}

// =============================================================================
// PRODUTOS
// tipo_baixa     : 'I' = Individual (baixa próprio estoque)
//                  'M' = Mestre/Kit  (baixa itens do kit vinculados)
// movimenta_estoque: false = produto não movimenta estoque em vendas/ajustes
// ativo          : false = produto inativado (soft delete de negócio)
// marca_id       : opcional — produto pode existir sem marca
// =============================================================================
model Produto {
  id                 String   @id @default(uuid())
  descricao          String
  marca_id           String?  // opcional — sem FK obrigatória
  preco_venda        Decimal  @db.Decimal(10, 2)
  custo_preco        Decimal  @db.Decimal(10, 2)
  cod_barras         String?  @unique
  codigo_interno     String?
  tipo_baixa         String   @default("I")  // 'I' | 'M'
  qtd_estoque        Decimal  @default(0)    @db.Decimal(10, 3)
  movimenta_estoque  Boolean  @default(true)
  ativo              Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  deleted            Boolean  @default(false)

  marca                     Marca?                @relation(fields: [marca_id], references: [id])
  kit_itens_como_mestre     ProdutoKitItem[]      @relation("KitMestre")
  kit_itens_como_individual ProdutoKitItem[]      @relation("KitIndividual")
  estoque_movimentacoes     EstoqueMovimentacao[]
  vendas_itens              VendaItem[]
  compras_itens             CompraItem[]

  @@map("produtos")
}

// =============================================================================
// PRODUTO KIT ITENS
// =============================================================================
model ProdutoKitItem {
  id                    String   @id @default(uuid())
  produto_mestre_id     String
  produto_individual_id String
  quantidade_necessaria Decimal  @db.Decimal(10, 3)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  deleted               Boolean  @default(false)

  produto_mestre     Produto @relation("KitMestre",     fields: [produto_mestre_id],     references: [id])
  produto_individual Produto @relation("KitIndividual", fields: [produto_individual_id], references: [id])

  @@unique([produto_mestre_id, produto_individual_id])
  @@map("produto_kit_itens")
}

// =============================================================================
// ESTOQUE MOVIMENTAÇÕES
// =============================================================================
model EstoqueMovimentacao {
  id                String           @id @default(uuid())
  produto_id        String
  tipo_movimentacao TipoMovimentacao
  quantidade        Decimal          @db.Decimal(10, 3)
  referencia_id     String?
  pessoa_id         String?
  data_movimentacao DateTime         @default(now())
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  deleted           Boolean          @default(false)

  produto Produto @relation(fields: [produto_id], references: [id])
  pessoa  Pessoa? @relation(fields: [pessoa_id],  references: [id])

  @@map("estoque_movimentacoes")
}

enum TipoMovimentacao {
  entrada_compra
  saida_venda
  ajuste_positivo
  ajuste_negativo
  devolucao_cliente
  devolucao_fornecedor
}

// =============================================================================
// VENDAS (header)
// data_venda: data real da transação — permite lançamento retroativo do PDV
// =============================================================================
model VendaHeader {
  id         String      @id @default(uuid())
  cliente_id String?
  status     StatusVenda @default(aberta)
  total      Decimal     @db.Decimal(10, 2)
  data_venda DateTime?   // nullable: registros antigos preservados
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  deleted    Boolean     @default(false)

  cliente    Pessoa?          @relation(fields: [cliente_id], references: [id])
  itens      VendaItem[]
  pagamentos VendaPagamento[]
  titulos    Titulo[]

  @@map("vendas")
}

enum StatusVenda {
  aberta
  finalizada
  cancelada
}

// =============================================================================
// VENDAS ITENS
// =============================================================================
model VendaItem {
  id                     String   @id @default(uuid())
  venda_id               String
  produto_id             String
  quantidade             Decimal  @db.Decimal(10, 3)
  preco_unitario         Decimal  @db.Decimal(10, 2)
  custo_unitario_gravado Decimal  @db.Decimal(10, 2)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  deleted                Boolean  @default(false)

  venda   VendaHeader @relation(fields: [venda_id],   references: [id])
  produto Produto     @relation(fields: [produto_id], references: [id])

  @@map("vendas_itens")
}

// =============================================================================
// VENDAS PAGAMENTOS
// =============================================================================
model VendaPagamento {
  id                 String   @id @default(uuid())
  venda_id           String
  forma_pagamento_id String
  valor              Decimal  @db.Decimal(10, 2)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  deleted            Boolean  @default(false)

  venda           VendaHeader    @relation(fields: [venda_id],           references: [id])
  forma_pagamento FormaPagamento @relation(fields: [forma_pagamento_id], references: [id])

  @@map("vendas_pagamentos")
}

// =============================================================================
// COMPRAS (header)
// =============================================================================
model CompraHeader {
  id            String       @id @default(uuid())
  fornecedor_id String?
  status        StatusCompra @default(aberta)
  total         Decimal      @db.Decimal(10, 2)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  deleted       Boolean      @default(false)

  fornecedor Pessoa?           @relation(fields: [fornecedor_id], references: [id])
  itens      CompraItem[]
  pagamentos CompraPagamento[]

  @@map("compras")
}

enum StatusCompra {
  aberta
  finalizada
  cancelada
}

// =============================================================================
// COMPRAS ITENS
// =============================================================================
model CompraItem {
  id             String   @id @default(uuid())
  compra_id      String
  produto_id     String
  quantidade     Decimal  @db.Decimal(10, 3)
  custo_unitario Decimal  @db.Decimal(10, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  deleted        Boolean  @default(false)

  compra  CompraHeader @relation(fields: [compra_id],  references: [id])
  produto Produto      @relation(fields: [produto_id], references: [id])

  @@map("compras_itens")
}

// =============================================================================
// COMPRAS PAGAMENTOS
// =============================================================================
model CompraPagamento {
  id                 String   @id @default(uuid())
  compra_id          String
  forma_pagamento_id String
  valor              Decimal  @db.Decimal(10, 2)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  deleted            Boolean  @default(false)

  compra          CompraHeader   @relation(fields: [compra_id],          references: [id])
  forma_pagamento FormaPagamento @relation(fields: [forma_pagamento_id], references: [id])

  @@map("compras_pagamentos")
}

// =============================================================================
// TÍTULOS (Contas a Receber) — NC-73/74/75
//
// Gerados na finalização da venda:
//   - tipo À vista/Cartão (NC-74): 1 único título, já com baixa automática
//     na data do dia (titulos_baixas).
//   - tipo A Prazo (NC-75): N títulos (1 por parcela, parcelas_total = N),
//     juros aplicado uma vez sobre o total e dividido igualmente entre as
//     parcelas; todos nascem com status "Aberto". Exige cliente_id na venda.
// =============================================================================
model Titulo {
  id                String   @id @default(uuid())
  venda_id          String
  cliente_id        String?
  parcela_numero    Int      @default(1) // ex.: 1 em "1/3"
  parcelas_total    Int      @default(1) // ex.: 3 em "1/3"
  valor_original    Decimal  @db.Decimal(10, 2)
  valor_taxa_cartao Decimal  @db.Decimal(10, 2) @default(0)
  valor_liquido     Decimal  @db.Decimal(10, 2)
  data_vencimento   DateTime
  status            String   @default("Aberto") // 'Aberto' | 'Baixado' | 'Parcial'
  reclassificado    Boolean  @default(false) // true se a forma de pagamento foi alterada num estorno (ver estornarBaixa)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted    Boolean  @default(false)

  venda   VendaHeader   @relation(fields: [venda_id],   references: [id])
  cliente Pessoa?       @relation(fields: [cliente_id], references: [id])
  baixas  TituloBaixa[]

  @@map("titulos")
}

// =============================================================================
// TÍTULOS BAIXAS (recebimentos) — NC-78
//
// Só aceita forma_pagamento de tipo 'V' (à vista) ou 'C' (cartão) — não dá
// pra "pagar uma dívida com outra dívida" (validado em financeiroService.js
// no app / financeiro.controller.js no backend, não como CHECK de banco).
// =============================================================================
model TituloBaixa {
  id                 String   @id @default(uuid())
  titulo_id          String
  forma_pagamento_id String
  valor_pago         Decimal  @db.Decimal(10, 2)
  valor_desconto     Decimal  @db.Decimal(10, 2) @default(0) // NC-77
  valor_juros        Decimal  @db.Decimal(10, 2) @default(0) // NC-77 — juros/mora
  valor_taxa_cartao  Decimal  @db.Decimal(10, 2) @default(0) // taxa da adquirente descontada nessa baixa (cartão)
  data_baixa         DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted    Boolean  @default(false)

  titulo          Titulo         @relation(fields: [titulo_id],          references: [id])
  forma_pagamento FormaPagamento @relation(fields: [forma_pagamento_id], references: [id])

  @@map("titulos_baixas")
}
